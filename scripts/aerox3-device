#!/usr/bin/env python3
"""Hardware access for the Aerox 3 plugin.

Writes go through rivalcfg's library rather than its CLI, because the CLI
cannot express which preset is active: `--sensitivity` always activates the
first entry, while the underlying command carries a selected-preset byte.

Reads are a different mechanism entirely. The mouse pushes an unsolicited
report whenever the DPI button is pressed, carrying both the active index and
the whole preset table, so `watch` can follow the physical button. Nothing
arrives on request — only on a press.

    aerox3-device presets 800,1200,1600 1 [--save|--no-save]
    aerox3-device polling 1000
    aerox3-device probe
    aerox3-device watch
"""

import json
import os
import select
import sys

VENDOR_ID = 0x1038
PRODUCT_ID = 0x1836

# Notification reports echo the sensitivity command id with the high bit set.
REPORT_ID = 0xAD
HIDRAW_DIR = os.environ.get("AEROX3_HIDRAW_DIR", "/sys/class/hidraw")


def dpi_table():
    """DPI code -> DPI value, inverted from rivalcfg's own device profile.

    Reusing the profile means the decode can never drift from the encode.
    """
    from rivalcfg.devices import aerox3

    choices = aerox3.profile["settings"]["sensitivity"]["output_choices"]
    return {code: dpi for dpi, code in choices.items()}


def decode_report(data):
    """Decode a DPI notification, or return None if this is not one.

    Layout: 0xAD, preset count, 0-based selected index, then one encoded DPI
    byte per preset.
    """
    if len(data) < 3 or data[0] != REPORT_ID:
        return None

    count = data[1]
    selected = data[2]
    if count < 1 or selected >= count or len(data) < 3 + count:
        return None

    table = dpi_table()
    presets = []
    for code in data[3 : 3 + count]:
        if code not in table:
            return None
        presets.append(table[code])

    return {"selected": selected, "presets": presets}


def hidraw_nodes():
    """Every hidraw node belonging to the Aerox 3.

    Which of its interfaces carries the notifications is not fixed, and the
    numbering shifts between replugs, so callers listen to all of them.
    """
    wanted = "%04x:%08x:%08x" % (3, VENDOR_ID, PRODUCT_ID)
    nodes = []
    try:
        entries = sorted(os.listdir(HIDRAW_DIR))
    except OSError:
        return nodes

    for name in entries:
        uevent = os.path.join(HIDRAW_DIR, name, "device", "uevent")
        try:
            with open(uevent) as handle:
                content = handle.read()
        except OSError:
            continue
        for line in content.splitlines():
            if line.startswith("HID_ID=") and line[7:].lower() == wanted:
                nodes.append("/dev/%s" % name)
                break
    return nodes


def open_mouse():
    import rivalcfg

    mouse = rivalcfg.get_first_mouse()
    if mouse is None:
        raise SystemExit("no SteelSeries Aerox 3 found")
    return mouse


def cmd_presets(argv):
    if len(argv) < 2:
        raise SystemExit("usage: aerox3-device presets <csv> <selected> [--save]")

    presets, selected = argv[0], int(argv[1])
    # Selection changes happen every time a preset is clicked; persisting each
    # one to the device's flash would wear it for no benefit, since startup
    # re-asserts the state anyway.
    save = "--save" in argv[2:]

    mouse = open_mouse()
    mouse.set_sensitivity(presets, selected)
    if save:
        mouse.save()


def cmd_polling(argv):
    if not argv:
        raise SystemExit("usage: aerox3-device polling <hz>")

    mouse = open_mouse()
    mouse.set_polling_rate(int(argv[0]))
    mouse.save()


def cmd_probe(argv):
    if not hidraw_nodes():
        raise SystemExit("no SteelSeries Aerox 3 found")


def cmd_watch(argv):
    nodes = hidraw_nodes()
    if not nodes:
        raise SystemExit("no SteelSeries Aerox 3 found")

    handles = {}
    for path in nodes:
        try:
            handles[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
        except OSError:
            continue
    if not handles:
        raise SystemExit("cannot read the mouse (check the rivalcfg udev rules)")

    last = None
    try:
        while True:
            ready, _, _ = select.select(list(handles), [], [])
            for handle in ready:
                try:
                    data = os.read(handle, 64)
                except OSError:
                    continue
                decoded = decode_report(data)
                if decoded is None or decoded == last:
                    continue
                last = decoded
                print(json.dumps(decoded), flush=True)
    except KeyboardInterrupt:
        pass


COMMANDS = {
    "presets": cmd_presets,
    "polling": cmd_polling,
    "probe": cmd_probe,
    "watch": cmd_watch,
}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        raise SystemExit(__doc__.strip())
    COMMANDS[argv[0]](argv[1:])


if __name__ == "__main__":
    main(sys.argv[1:])
