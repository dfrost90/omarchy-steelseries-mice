#!/usr/bin/env bash
# Tests for the aerox3 wrapper script.
#
# The device helper is stubbed so no HID writes happen. The stub records the
# exact argv it was called with, which is what most of these assertions read.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AEROX3="$SCRIPT_DIR/scripts/aerox3"

pass=0
fail=0

setup() {
  SANDBOX="$(mktemp -d)"
  STUB_BIN="$SANDBOX/bin"
  mkdir -p "$STUB_BIN"

  DEVICE_LOG="$SANDBOX/device.log"
  DEVICE_EXIT=0

  cat >"$STUB_BIN/aerox3-device" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$DEVICE_LOG"
[ -n "${DEVICE_STDERR:-}" ] && printf '%s\n' "$DEVICE_STDERR" >&2
[ -n "${DEVICE_STDOUT:-}" ] && printf '%s\n' "$DEVICE_STDOUT"
exit "${DEVICE_EXIT:-0}"
STUB
  chmod +x "$STUB_BIN/aerox3-device"

  STATE_FILE="$SANDBOX/state.json"

  export DEVICE_LOG DEVICE_EXIT
  export AEROX3_STATE_FILE="$STATE_FILE"
  export AEROX3_DEVICE="$STUB_BIN/aerox3-device"
}

teardown() {
  [ -n "${SANDBOX:-}" ] && rm -rf "$SANDBOX"
  unset DEVICE_STDERR DEVICE_STDOUT
}

check() {
  local name="$1" expected="$2" actual="$3"
  if [ "$expected" = "$actual" ]; then
    pass=$((pass + 1))
    printf '  ok   %s\n' "$name"
  else
    fail=$((fail + 1))
    printf '  FAIL %s\n       expected: %s\n       actual:   %s\n' "$name" "$expected" "$actual"
  fi
}

check_contains() {
  local name="$1" needle="$2" haystack="$3"
  if [[ "$haystack" == *"$needle"* ]]; then
    pass=$((pass + 1))
    printf '  ok   %s\n' "$name"
  else
    fail=$((fail + 1))
    printf '  FAIL %s\n       expected to contain: %s\n       actual:              %s\n' "$name" "$needle" "$haystack"
  fi
}

# --- writing the preset table ----------------------------------------------

setup
"$AEROX3" set --presets 800,1200,1600 >/dev/null 2>&1
check "set --presets writes the table with the first preset selected" \
  "presets 800,1200,1600 0 --save" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$AEROX3" set --presets 800,1200,1600 --selected 2 >/dev/null 2>&1
check "set --presets honours an explicit selection" \
  "presets 800,1200,1600 2 --save" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$AEROX3" set --presets 1637,2350 >/dev/null 2>&1
check "preset values round to the nearest 100" \
  "presets 1600,2400 0 --save" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$AEROX3" set --presets 50,99999 >/dev/null 2>&1
check "preset values clamp to the device range" \
  "presets 200,8500 0 --save" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
out="$("$AEROX3" set --presets 800,900,1000,1100,1200,1300 2>&1)"
rc=$?
check "more than five presets is rejected" "1" "$rc"
check "an over-long preset list never reaches the device" "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
check_contains "the five-preset limit is explained" "5" "$out"
teardown

# The device must always hold at least one preset: a table of zero would
# leave the mouse with no sensitivity at all, and the panel hides its remove
# control at one row for the same reason.
setup
out="$("$AEROX3" set --presets "" 2>&1)"
rc=$?
check "an empty preset list is rejected" "1" "$rc"
teardown

setup
out="$("$AEROX3" set --presets "   " 2>&1)"
rc=$?
check "a whitespace-only preset list is rejected" "1" "$rc"
check "a whitespace-only preset list never reaches the device" "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
out="$("$AEROX3" set --presets ",," 2>&1)"
rc=$?
check "a separator-only preset list is rejected" "1" "$rc"
check_contains "an empty preset value is named as such" "empty" "$out"
teardown

setup
"$AEROX3" set --presets 800,1200 >/dev/null 2>&1
out="$("$AEROX3" set --presets "800," 2>&1)"
rc=$?
check "a trailing separator is rejected rather than silently dropped" "1" "$rc"
check "the stored table survives a rejected edit" \
  "800,1200" "$("$AEROX3" get | jq -r '.presets | join(",")')"
teardown

setup
out="$("$AEROX3" set --presets 800,abc 2>&1)"
rc=$?
check "a non-numeric preset is rejected" "1" "$rc"
check "a non-numeric preset never reaches the device" "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
out="$("$AEROX3" set --presets 800,1200 --selected 5 2>&1)"
rc=$?
check "a selection outside the table is rejected" "1" "$rc"
check "an out-of-range selection never reaches the device" "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

# --- switching the active preset -------------------------------------------

setup
"$AEROX3" set --presets 800,1200,1600 >/dev/null 2>&1
: >"$DEVICE_LOG"
"$AEROX3" select 2 >/dev/null 2>&1
check "select rewrites the same table with the new selection" \
  "presets 800,1200,1600 2 --no-save" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$AEROX3" set --presets 800,1200,1600 >/dev/null 2>&1
"$AEROX3" select 2 >/dev/null 2>&1
check "select updates the stored selection" "2" "$("$AEROX3" get | jq -r .selected)"
check "select leaves the stored table alone" \
  "800,1200,1600" "$("$AEROX3" get | jq -r '.presets | join(",")')"
teardown

setup
"$AEROX3" set --presets 800,1200 >/dev/null 2>&1
out="$("$AEROX3" select 7 2>&1)"
rc=$?
check "selecting a preset that does not exist is rejected" "1" "$rc"
teardown

# --- active DPI ------------------------------------------------------------

setup
"$AEROX3" set --presets 800,1200,1600 --selected 1 >/dev/null 2>&1
check "get reports the selected preset's DPI as the active one" \
  "1200" "$("$AEROX3" get | jq -r .activeDpi)"
teardown

setup
check "get falls back to the device default table" \
  "800,1600" "$("$AEROX3" get | jq -r '.presets | join(",")')"
check "get flags the fallback table as assumed" "true" "$("$AEROX3" get | jq -r .assumed)"
teardown

setup
"$AEROX3" set --presets 800,1200,1600 >/dev/null 2>&1
check "get reports state as known once a table was applied" \
  "false" "$("$AEROX3" get | jq -r .assumed)"
teardown

# --- polling rate ----------------------------------------------------------

setup
"$AEROX3" set --polling 500 >/dev/null 2>&1
check "set --polling forwards the rate to the device" \
  "polling 500" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
out="$("$AEROX3" set --polling 333 2>&1)"
rc=$?
check "an unsupported polling rate is rejected" "1" "$rc"
check "an unsupported polling rate never reaches the device" "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
check_contains "the valid polling rates are listed" "125" "$out"
teardown

setup
"$AEROX3" set --presets 800,1200 >/dev/null 2>&1
"$AEROX3" set --polling 250 >/dev/null 2>&1
check "setting the polling rate preserves the preset table" \
  "800,1200" "$("$AEROX3" get | jq -r '.presets | join(",")')"
teardown

# --- observing the physical DPI button -------------------------------------

setup
"$AEROX3" set --presets 800,1200,1600 >/dev/null 2>&1
"$AEROX3" observe 2 >/dev/null 2>&1
check "observe records a selection the mouse reported" \
  "2" "$("$AEROX3" get | jq -r .selected)"
teardown

setup
"$AEROX3" set --presets 800,1200,1600 >/dev/null 2>&1
: >"$DEVICE_LOG"
"$AEROX3" observe 2 >/dev/null 2>&1
check "observe never writes back to the device" "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$AEROX3" set --presets 800,1200,1600 >/dev/null 2>&1
"$AEROX3" observe 1 --presets 400,900 >/dev/null 2>&1
check "observe adopts a table that disagrees with ours" \
  "400,900" "$("$AEROX3" get | jq -r '.presets | join(",")')"
check "observe adopting a table keeps its reported selection" \
  "1" "$("$AEROX3" get | jq -r .selected)"
teardown

setup
out="$("$AEROX3" observe 9 2>&1)"
rc=$?
check "observe rejects a selection outside the known table" "1" "$rc"
teardown

# --- apply -----------------------------------------------------------------

setup
"$AEROX3" set --presets 800,1200,1600 --selected 1 >/dev/null 2>&1
: >"$DEVICE_LOG"
"$AEROX3" apply >/dev/null 2>&1
check "apply re-asserts the stored table and selection without saving" \
  "presets 800,1200,1600 1 --no-save
polling 1000" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$AEROX3" apply >/dev/null 2>&1
check "apply with nothing stored does nothing" "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

# --- failures --------------------------------------------------------------

setup
export DEVICE_EXIT=1
export DEVICE_STDERR="Device not found"
out="$("$AEROX3" set --presets 800 2>&1)"
rc=$?
check "a failed write exits non-zero" "1" "$rc"
teardown

setup
"$AEROX3" set --presets 800,1200 >/dev/null 2>&1
export DEVICE_EXIT=1
"$AEROX3" set --presets 3200 >/dev/null 2>&1
check "a failed write does not overwrite the last known good table" \
  "800,1200" "$("$AEROX3" get | jq -r '.presets | join(",")')"
teardown

setup
export DEVICE_EXIT=1
export DEVICE_STDERR="Device not found"
check "get surfaces the last error" \
  "Device not found" \
  "$("$AEROX3" set --presets 800 >/dev/null 2>&1; "$AEROX3" get | jq -r .error)"
teardown

setup
export AEROX3_DEVICE="$SANDBOX/absent/aerox3-device"
out="$("$AEROX3" set --presets 800 2>&1)"
rc=$?
check "a missing device helper exits non-zero" "1" "$rc"
teardown

# --- state file resilience -------------------------------------------------

# A state file written by an older version has no preset table. Treating its
# appliedAt as proof of a known table would push our *default* table onto the
# device as though the user had chosen it.
setup
printf '{"dpi":800,"polling":1000,"appliedAt":"2026-08-19T21:43:37+03:00"}' >"$STATE_FILE"
"$AEROX3" apply >/dev/null 2>&1
check "a state file with no preset table never asserts a guessed table" \
  "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
printf '{"dpi":800,"polling":1000,"appliedAt":"2026-08-19T21:43:37+03:00"}' >"$STATE_FILE"
check "a state file with no preset table reports itself as assumed" \
  "true" "$("$AEROX3" get | jq -r .assumed)"
teardown

setup
printf 'not json at all' >"$STATE_FILE"
check "a corrupt state file falls back to defaults" \
  "800,1600" "$("$AEROX3" get | jq -r '.presets | join(",")')"
teardown

setup
printf '{"presets":[800,1200],"selected":9}' >"$STATE_FILE"
check "a stored selection past the end of the table is clamped" \
  "1" "$("$AEROX3" get | jq -r .selected)"
teardown

# --- output contract -------------------------------------------------------

setup
check "get emits valid JSON" "ok" "$("$AEROX3" get | jq -e . >/dev/null 2>&1 && echo ok)"
teardown

setup
check "set echoes the resulting state as JSON" \
  "1200" "$("$AEROX3" set --presets 800,1200 --selected 1 2>/dev/null | jq -r .activeDpi)"
teardown

setup
out="$("$AEROX3" bogus-command 2>&1)"
rc=$?
check "an unknown subcommand exits non-zero" "1" "$rc"
check_contains "an unknown subcommand prints usage" "usage" "$out"
teardown

printf '\n%d passed, %d failed\n' "$pass" "$fail"

echo
echo "device helper:"
python3 "$SCRIPT_DIR/tests/test_device.py" || fail=$((fail + 1))

[ "$fail" -eq 0 ]
