#!/usr/bin/env bash
# Tests for the steelseries wrapper script.
#
# The device helper is stubbed so no HID writes happen, and sysfs is faked so
# the tests can pretend any mouse is plugged in. The stub records the exact
# argv it was called with, which is what most of these assertions read; it also
# serves whatever capabilities the test asked for, which is how one suite
# covers devices nobody here owns.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STEELSERIES="$SCRIPT_DIR/scripts/steelseries"

pass=0
fail=0

# The Aerox 3: a preset table of 1-5, a selectable active preset, and a DPI
# range. This is the shape every unqualified test below runs against.
CAPS_TABLE='{"connected":true,"device":"1038:1836","name":"SteelSeries Aerox 3",
  "mode":"table","dpiMin":200,"dpiMax":8500,"dpiStep":100,"dpiValues":[],
  "presetMin":1,"presetMax":5,"selectable":true,"tracking":true,"verified":true,
  "pollingOptions":[125,250,500,1000],"defaultPolling":1000,"defaultPresets":[800,1600]}'

# An Aerox 5 Wireless: same shape, wider range, finer minimum.
CAPS_WIDE='{"connected":true,"device":"1038:1854","name":"SteelSeries Aerox 5 Wireless",
  "mode":"table","dpiMin":100,"dpiMax":18000,"dpiStep":100,"dpiValues":[],
  "presetMin":1,"presetMax":5,"selectable":true,"tracking":true,"verified":false,
  "pollingOptions":[125,250,500,1000],"defaultPolling":1000,"defaultPresets":[400,800,1200,2400,3200]}'

# A Kinzu v2: two fixed slots, no selection byte, and only four legal DPI
# values with nothing in between.
CAPS_PAIR='{"connected":true,"device":"1038:1366","name":"SteelSeries Kinzu v2",
  "mode":"pair","dpiMin":400,"dpiMax":3200,"dpiStep":0,"dpiValues":[400,800,1600,3200],
  "presetMin":2,"presetMax":2,"selectable":false,"tracking":false,"verified":false,
  "pollingOptions":[125,500,1000],"defaultPolling":1000,"defaultPresets":[800,3200]}'

setup() {
  SANDBOX="$(mktemp -d)"
  STUB_BIN="$SANDBOX/bin"
  mkdir -p "$STUB_BIN"

  DEVICE_LOG="$SANDBOX/device.log"
  CAPS_LOG="$SANDBOX/caps.log"
  CAPS_FILE="$SANDBOX/caps.json"
  DEVICE_EXIT=0
  printf '%s' "$CAPS_TABLE" >"$CAPS_FILE"

  # Faked sysfs. The script reads these to decide, cheaply, whether asking the
  # helper anything is worthwhile.
  HIDRAW="$SANDBOX/hidraw"
  mkdir -p "$HIDRAW/hidraw0/device"
  printf 'DRIVER=hid-generic\nHID_ID=0003:00001038:00001836\n' \
    >"$HIDRAW/hidraw0/device/uevent"

  cat >"$STUB_BIN/steelseries-device" <<'STUB'
#!/usr/bin/env bash
if [ "${1:-}" = capabilities ]; then
  printf 'capabilities\n' >>"$CAPS_LOG"
  cat "$CAPS_FILE"
  exit 0
fi
printf '%s\n' "$*" >>"$DEVICE_LOG"
[ -n "${DEVICE_STDERR:-}" ] && printf '%s\n' "$DEVICE_STDERR" >&2
[ -n "${DEVICE_STDOUT:-}" ] && printf '%s\n' "$DEVICE_STDOUT"
exit "${DEVICE_EXIT:-0}"
STUB
  chmod +x "$STUB_BIN/steelseries-device"

  STATE_FILE="$SANDBOX/state.json"

  export DEVICE_LOG CAPS_LOG CAPS_FILE DEVICE_EXIT
  export STEELSERIES_STATE_FILE="$STATE_FILE"
  export STEELSERIES_HIDRAW_DIR="$HIDRAW"
  export STEELSERIES_DEVICE="$STUB_BIN/steelseries-device"
}

# Pretend a different mouse is plugged in.
use_device() {
  printf '%s' "$1" >"$CAPS_FILE"
  local ident
  ident=$(jq -r .device <<<"$1")
  printf 'DRIVER=hid-generic\nHID_ID=0003:0000%s:0000%s\n' \
    "${ident%%:*}" "${ident##*:}" >"$HIDRAW/hidraw0/device/uevent"
}

unplug() {
  rm -f "$HIDRAW/hidraw0/device/uevent"
}

teardown() {
  [ -n "${SANDBOX:-}" ] && rm -rf "$SANDBOX"
  unset DEVICE_STDERR DEVICE_STDOUT
}

check() {
  local name="$1" expected="$2" actual="$3"
  if [ "$expected" = "$actual" ]; then
    pass=$((pass + 1))
    printf '  ok   %s\n' "$name"
  else
    fail=$((fail + 1))
    printf '  FAIL %s\n       expected: %s\n       actual:   %s\n' "$name" "$expected" "$actual"
  fi
}

check_contains() {
  local name="$1" needle="$2" haystack="$3"
  if [[ "$haystack" == *"$needle"* ]]; then
    pass=$((pass + 1))
    printf '  ok   %s\n' "$name"
  else
    fail=$((fail + 1))
    printf '  FAIL %s\n       expected to contain: %s\n       actual:              %s\n' "$name" "$needle" "$haystack"
  fi
}

# --- writing the preset table ----------------------------------------------

setup
"$STEELSERIES" set --presets 800,1200,1600 >/dev/null 2>&1
check "set --presets writes the table with the first preset selected" \
  "presets 800,1200,1600 0 --save" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$STEELSERIES" set --presets 800,1200,1600 --selected 2 >/dev/null 2>&1
check "set --presets honours an explicit selection" \
  "presets 800,1200,1600 2 --save" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$STEELSERIES" set --presets 1637,2350 >/dev/null 2>&1
check "preset values round to the nearest step" \
  "presets 1600,2400 0 --save" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$STEELSERIES" set --presets 50,99999 >/dev/null 2>&1
check "preset values clamp to the device's range" \
  "presets 200,8500 0 --save" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
out="$("$STEELSERIES" set --presets 800,900,1000,1100,1200,1300 2>&1)"
check "a table longer than the device holds is rejected" \
  "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
check_contains "the too-long table explains the limit" "at most 5" "$out"
teardown

setup
out="$("$STEELSERIES" set --presets "800," 2>&1)"
check "a trailing comma does not silently shrink the table" \
  "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
check_contains "the trailing comma is explained" "empty or non-numeric" "$out"
teardown

setup
out="$("$STEELSERIES" set --presets "800,abc" 2>&1)"
check_contains "a non-numeric preset is rejected" "empty or non-numeric" "$out"
teardown

setup
out="$("$STEELSERIES" set --polling 500 --selected 1 2>&1)"
check_contains "--selected without a table is rejected" "only makes sense" "$out"
teardown

# --- capabilities drive the limits -----------------------------------------

setup
use_device "$CAPS_WIDE"
"$STEELSERIES" set --presets 12000,50 >/dev/null 2>&1
check "a wider device accepts DPI the Aerox 3 would clamp" \
  "presets 12000,100 0 --save" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
use_device "$CAPS_WIDE"
check "the DPI range is reported from the device profile" \
  "100 18000" \
  "$("$STEELSERIES" get | jq -r '"\(.dpiMin) \(.dpiMax)"')"
teardown

setup
use_device "$CAPS_PAIR"
"$STEELSERIES" set --presets 900,3000 >/dev/null 2>&1
check "a device with fixed DPI values snaps to the nearest one" \
  "pair 800 3200" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
use_device "$CAPS_PAIR"
out="$("$STEELSERIES" set --presets 800,1600,3200 2>&1)"
check "a fixed-slot device rejects a third slot" \
  "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
check_contains "the extra slot is explained" "at most 2" "$out"
teardown

setup
use_device "$CAPS_PAIR"
out="$("$STEELSERIES" set --presets 800 2>&1)"
check_contains "a fixed-slot device rejects a single slot" "at least 2" "$out"
teardown

setup
use_device "$CAPS_PAIR"
out="$("$STEELSERIES" select 1 2>&1)"
check "a device with no selection byte is never sent one" \
  "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
check_contains "the missing selection is explained" "fixed DPI slots" "$out"
teardown

setup
use_device "$CAPS_PAIR"
check "polling options come from the device profile" \
  "125 500 1000" \
  "$("$STEELSERIES" get | jq -r '.pollingOptions | join(" ")')"
teardown

setup
use_device "$CAPS_PAIR"
out="$("$STEELSERIES" set --polling 250 2>&1)"
check_contains "a polling rate the device lacks is rejected" "must be one of" "$out"
teardown

# --- polling rate ----------------------------------------------------------

setup
"$STEELSERIES" set --polling 500 >/dev/null 2>&1
check "set --polling forwards the rate" "polling 500" "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
out="$("$STEELSERIES" set --polling 333 2>&1)"
check "an unsupported polling rate never reaches the device" \
  "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
check_contains "the unsupported rate is explained" "must be one of" "$out"
teardown

# --- selecting a preset ----------------------------------------------------

setup
"$STEELSERIES" set --presets 800,1200,1600 >/dev/null 2>&1
: >"$DEVICE_LOG"
"$STEELSERIES" select 2 >/dev/null 2>&1
check "select rewrites the table without persisting it" \
  "presets 800,1200,1600 2 --no-save" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$STEELSERIES" set --presets 800,1200 >/dev/null 2>&1
: >"$DEVICE_LOG"
out="$("$STEELSERIES" select 4 2>&1)"
check "selecting a preset that does not exist writes nothing" \
  "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
check_contains "the missing preset is explained" "does not exist" "$out"
teardown

setup
out="$("$STEELSERIES" select 2>&1)"
check_contains "select without an index is rejected" "needs a preset index" "$out"
teardown

# --- observing the physical button -----------------------------------------

setup
"$STEELSERIES" observe 1 --presets 800,1600,3200 >/dev/null 2>&1
check "observe records the report without writing to the device" \
  "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$STEELSERIES" observe 2 --presets 800,1600,3200 >/dev/null 2>&1
check "observe replaces the stored table with what the device reported" \
  "800 1600 3200 2" \
  "$("$STEELSERIES" get | jq -r '"\(.presets | join(" ")) \(.selected)"')"
teardown

setup
"$STEELSERIES" observe 0 --presets 800,1600 >/dev/null 2>&1
check "an observed state is no longer assumed" \
  "false" "$("$STEELSERIES" get | jq -r .assumed)"
teardown

# --- re-asserting on startup -----------------------------------------------

setup
"$STEELSERIES" apply >/dev/null 2>&1
check "apply writes nothing when nothing has ever been applied" \
  "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
"$STEELSERIES" set --presets 800,1200 --selected 1 >/dev/null 2>&1
: >"$DEVICE_LOG"
"$STEELSERIES" apply >/dev/null 2>&1
check "apply re-asserts the stored table without persisting it" \
  "presets 800,1200 1 --no-save
polling 1000" \
  "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
printf '{"presets":[800,1600],"selected":0,"appliedAt":"2026-01-01T00:00:00+00:00"}' >"$STATE_FILE"
"$STEELSERIES" apply >/dev/null 2>&1
check "a state file from an older format is not asserted onto the mouse" \
  "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
teardown

setup
printf '{"version":1,"presets":[800,1600],"appliedAt":"2026-01-01T00:00:00+00:00"}' >"$STATE_FILE"
check "an older state file leaves the state assumed" \
  "true" "$("$STEELSERIES" get | jq -r .assumed)"
teardown

# --- state file ------------------------------------------------------------

setup
"$STEELSERIES" set --presets 800,1200,1600 --selected 1 >/dev/null 2>&1
check "state is stored under the device it belongs to" \
  "800 1200 1600" \
  "$(jq -r '.devices["1038:1836"].presets | join(" ")' "$STATE_FILE")"
teardown

setup
"$STEELSERIES" set --presets 800,1200 >/dev/null 2>&1
use_device "$CAPS_PAIR"
"$STEELSERIES" set --presets 400,1600 >/dev/null 2>&1
check "swapping mice does not discard what we knew about the first" \
  "800 1200" \
  "$(jq -r '.devices["1038:1836"].presets | join(" ")' "$STATE_FILE")"
check "each mouse keeps its own table" \
  "400 1600" \
  "$(jq -r '.devices["1038:1366"].presets | join(" ")' "$STATE_FILE")"
teardown

setup
printf '{"version":2,"devices":{"1038:1836":{"presets":[800,1200],"selected":9}}}' >"$STATE_FILE"
check "a stored selection past the end of the table is clamped" \
  "1" "$("$STEELSERIES" get | jq -r .selected)"
teardown

setup
"$STEELSERIES" get >/dev/null 2>&1
"$STEELSERIES" set --presets 800,1200 >/dev/null 2>&1
: >"$CAPS_LOG"
"$STEELSERIES" get >/dev/null 2>&1
"$STEELSERIES" get >/dev/null 2>&1
check "capabilities are cached rather than re-derived on every call" \
  "0" "$(wc -l <"$CAPS_LOG")"
teardown

setup
"$STEELSERIES" set --presets 800,1200 >/dev/null 2>&1
use_device "$CAPS_PAIR"
: >"$CAPS_LOG"
"$STEELSERIES" get >/dev/null 2>&1
check "plugging in a different mouse re-derives its capabilities" \
  "1" "$(wc -l <"$CAPS_LOG")"
teardown

# --- nothing plugged in ----------------------------------------------------

setup
unplug
check "an unplugged mouse reports itself disconnected" \
  "false" "$("$STEELSERIES" get | jq -r .connected)"
teardown

setup
unplug
check "an unplugged mouse still emits a complete object" \
  "ok" "$("$STEELSERIES" get | jq -e '.presets and .polling and has("assumed")' >/dev/null 2>&1 && echo ok)"
teardown

setup
unplug
: >"$CAPS_LOG"
"$STEELSERIES" get >/dev/null 2>&1
check "an unplugged mouse costs no helper process at all" \
  "0" "$(wc -l <"$CAPS_LOG")"
teardown

setup
unplug
out="$("$STEELSERIES" set --presets 800,1600 2>&1)"
check "writing with nothing plugged in touches no device" \
  "" "$(cat "$DEVICE_LOG" 2>/dev/null)"
check_contains "the missing mouse is explained" "no supported SteelSeries mouse" "$out"
teardown

# --- failures --------------------------------------------------------------

setup
DEVICE_EXIT=1 DEVICE_STDERR="rivalcfg exploded" \
  "$STEELSERIES" set --presets 800,1200 >/dev/null 2>&1
check "a failed write is recorded rather than swallowed" \
  "rivalcfg exploded" "$("$STEELSERIES" get | jq -r .error)"
teardown

setup
DEVICE_EXIT=1 DEVICE_STDERR="rivalcfg exploded" \
  "$STEELSERIES" set --presets 3200,6400 >/dev/null 2>&1
check "a failed write leaves the previously known table alone" \
  "800 1600" "$("$STEELSERIES" get | jq -r '.presets | join(" ")')"
teardown

setup
"$STEELSERIES" set --presets 800,1200 >/dev/null 2>&1
export STEELSERIES_DEVICE="$SANDBOX/bin/does-not-exist"
check "a missing device helper is reported" \
  "false" "$("$STEELSERIES" get | jq -r .helper)"
teardown

# --- ceilings on what we read ----------------------------------------------
#
# Every ceiling here is overridden down to something a test can build, so these
# exercise the boundary itself rather than a quarter of a megabyte of padding.

setup
"$STEELSERIES" set --presets 800,1200 >/dev/null 2>&1
size=$(wc -c <"$STATE_FILE")
head -c 100 /dev/zero | tr '\0' 'X' >>"$STATE_FILE"
check "a state file whose first bytes parse is still refused for its size" \
  "800 1600" \
  "$(STEELSERIES_STATE_MAX_BYTES=$size "$STEELSERIES" get | jq -r '.presets | join(" ")')"
teardown

setup
"$STEELSERIES" set --presets 800,1200 >/dev/null 2>&1
size=$(wc -c <"$STATE_FILE")
head -c 100 /dev/zero | tr '\0' 'X' >>"$STATE_FILE"
before=$(wc -c <"$STATE_FILE")
out=$(STEELSERIES_STATE_MAX_BYTES=$size "$STEELSERIES" observe 0 --presets 800,1600 2>&1)
check_contains "an oversized state file is refused rather than rewritten" \
  "refusing to overwrite" "$out"
check "the oversized state file is left exactly as it was" \
  "$before" "$(wc -c <"$STATE_FILE")"
teardown

setup
"$STEELSERIES" set --presets 800,1200 >/dev/null 2>&1
size=$(wc -c <"$STATE_FILE")
head -c 100 /dev/zero | tr '\0' 'X' >>"$STATE_FILE"
: >"$CAPS_LOG"
STEELSERIES_STATE_MAX_BYTES=$size "$STEELSERIES" get >/dev/null 2>&1
check "an oversized state file is not mined for cached capabilities either" \
  "1" "$(wc -l <"$CAPS_LOG")"
teardown

setup
caps_size=$(printf '%s' "$CAPS_TABLE" | wc -c)
check "a capabilities answer exactly at the ceiling is accepted" \
  "true" \
  "$(STEELSERIES_STDOUT_MAX_BYTES=$caps_size "$STEELSERIES" get | jq -r .connected)"
teardown

setup
caps_size=$(printf '%s' "$CAPS_TABLE" | wc -c)
printf '%s ' "$CAPS_TABLE" >"$CAPS_FILE"
check "a capabilities answer one byte past the ceiling is refused" \
  "false" \
  "$(STEELSERIES_STDOUT_MAX_BYTES=$caps_size "$STEELSERIES" get | jq -r .connected)"
teardown

setup
{ head -c 70000 /dev/zero | tr '\0' '#' | fold -w 100
  printf 'DRIVER=hid-generic\nHID_ID=0003:00001038:00001836\n'; } \
  >"$HIDRAW/hidraw0/device/uevent"
check "a uevent is read under a ceiling like every other outside file" \
  "false" "$("$STEELSERIES" get | jq -r .connected)"
teardown

setup
{ printf 'DRIVER=hid-generic\nHID_ID=0003:00001038:00001836\n'
  head -c 70000 /dev/zero | tr '\0' '#' | fold -w 100; } \
  >"$HIDRAW/hidraw0/device/uevent"
check "a padded uevent still matches on what fits under the ceiling" \
  "true" "$("$STEELSERIES" get | jq -r .connected)"
teardown

setup
out=$(STEELSERIES_STATE_MAX_BYTES="a[\$(touch $SANDBOX/pwned)]" "$STEELSERIES" get 2>&1)
check_contains "a ceiling that is not a number is refused" \
  "must be a positive whole number" "$out"
check "a ceiling never reaches bash arithmetic as an expression" \
  "" "$(ls "$SANDBOX/pwned" 2>/dev/null)"
teardown

# --- how many, not just what shape -----------------------------------------

setup
jq -n '{version:2,devices:{"1038:1836":{presets:[800,900,1000,1100,1200],
  selected:0,polling:1000,appliedAt:"x",observedAt:"",error:""}}}' >"$STATE_FILE"
check "a stored table exactly as long as the device holds is kept" \
  "800 900 1000 1100 1200" \
  "$("$STEELSERIES" get | jq -r '.presets | join(" ")')"
teardown

setup
jq -n '{version:2,devices:{"1038:1836":{presets:[800,900,1000,1100,1200,1300],
  selected:0,polling:1000,appliedAt:"x",observedAt:"",error:""}}}' >"$STATE_FILE"
check "a stored table one longer than the device holds is refused" \
  "800 1600" \
  "$("$STEELSERIES" get | jq -r '.presets | join(" ")')"
teardown

setup
# One chip per entry on the panel, and an execve argument past 128K before the
# panel ever sees it. Shape alone says nothing about how many.
jq -n '{version:2,devices:{"1038:1836":{presets:[range(20000)|800],
  selected:0,polling:1000,appliedAt:"x",observedAt:"",error:""}}}' >"$STATE_FILE"
out=$("$STEELSERIES" get 2>&1)
check "a stored table of twenty thousand is refused, not emitted" \
  "800 1600" "$(jq -r '.presets | join(" ")' <<<"$out" 2>/dev/null)"
check_contains "and get still emits valid JSON rather than failing" \
  '"connected":true' "$(jq -c '{connected}' <<<"$out" 2>/dev/null)"
teardown

setup
"$STEELSERIES" set --presets 800,1200 >/dev/null 2>&1
# Past the helper's ceiling but under the state file's, which is exactly where
# the two used to disagree — and past what execve takes as one argument.
jq '.capabilities.pad = ("A" * 70000)' "$STATE_FILE" >"$SANDBOX/padded.json"
mv "$SANDBOX/padded.json" "$STATE_FILE"
: >"$CAPS_LOG"
out=$("$STEELSERIES" get 2>&1)
check "an oversized cached capabilities blob is dropped, not passed on" \
  "true" "$(jq -r 'has("pad") | not' <<<"$out" 2>/dev/null)"
check "and the helper is asked again in its place" "1" "$(wc -l <"$CAPS_LOG")"
teardown

setup
# Every mouse ever plugged in keeps an entry, so this map is the one value in
# the state file that grows with use. Past 128K it no longer fits in a single
# execve argument, and every write from then on would fail rather than any one.
jq -n --argjson caps "$CAPS_TABLE" '{version:2,probeKey:"1038:1836",
  capabilities:$caps,
  devices:(reduce range(1300) as $i ({}; . + {("1038:\($i)"):
    {presets:[800,1600],selected:0,polling:1000,
     appliedAt:"x",observedAt:"",error:""}}))}' >"$STATE_FILE"
check "the device map is large enough to matter" \
  "yes" "$([ "$(jq -c .devices "$STATE_FILE" | wc -c)" -gt 131072 ] && echo yes)"
"$STEELSERIES" observe 0 --presets 800,1600 >/dev/null 2>&1
check "a large device map still writes, and keeps every entry" \
  "1301" "$(jq '.devices | length' "$STATE_FILE" 2>/dev/null)"
teardown

# --- the watch stream ------------------------------------------------------

setup
cat >"$STUB_BIN/steelseries-device" <<'STUB'
#!/usr/bin/env bash
if [ "${1:-}" = capabilities ]; then cat "$CAPS_FILE"; exit 0; fi
# One well-formed report, then a flood with no newline in it anywhere.
printf '{"selected":0,"presets":[800,1600]}\n'
head -c 20000 /dev/zero | tr '\0' 'A'
STUB
chmod +x "$STUB_BIN/steelseries-device"
watched=$(STEELSERIES_LINE_MAX_BYTES=512 "$STEELSERIES" watch 2>/dev/null)
check "a real report crosses the wrapper untouched" \
  '{"selected":0,"presets":[800,1600]}' \
  "$(head -1 <<<"$watched")"
check "a newline-free flood is cut into lines the reader can bound" \
  "512" \
  "$(awk 'NR > 1 { print length($0); exit }' <<<"$watched")"
teardown

setup
export STEELSERIES_DEVICE="$SANDBOX/bin/does-not-exist"
out=$("$STEELSERIES" watch 2>&1)
check_contains "watch without a device helper says so" "device helper not found" "$out"
teardown

# --- output contract -------------------------------------------------------

setup
check "get emits valid JSON" "ok" "$("$STEELSERIES" get | jq -e . >/dev/null 2>&1 && echo ok)"
teardown

setup
check "get reports the device by name" \
  "SteelSeries Aerox 3" "$("$STEELSERIES" get | jq -r .name)"
teardown

setup
use_device "$CAPS_WIDE"
check "an untested device says so" \
  "false" "$("$STEELSERIES" get | jq -r .verified)"
teardown

setup
check "set echoes the resulting state as JSON" \
  "1200" "$("$STEELSERIES" set --presets 800,1200 --selected 1 2>/dev/null | jq -r .activeDpi)"
teardown

setup
out="$("$STEELSERIES" bogus-command 2>&1)"
rc=$?
check "an unknown subcommand exits non-zero" "1" "$rc"
check_contains "an unknown subcommand prints usage" "usage" "$out"
teardown

printf '\n%d passed, %d failed\n' "$pass" "$fail"

echo
echo "device helper:"
python3 "$SCRIPT_DIR/tests/test_device.py" || fail=$((fail + 1))

# The panel's own validation, lifted straight out of BarWidget.qml. Guarded
# rather than required: nothing else here needs a JS engine, and the plugin
# itself needs only the one already inside Quickshell.
echo
echo "panel:"
if command -v node >/dev/null 2>&1; then
  node "$SCRIPT_DIR/tests/test_panel.js" || fail=$((fail + 1))
else
  echo "  skipped — no node to run BarWidget.qml's own logic against"
fi

[ "$fail" -eq 0 ]
